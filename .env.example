COMPOSE_PROJECT_NAME=signalforge-java-dev
POSTGRES_DB=signalforge_java
POSTGRES_USER=signalforge
POSTGRES_PASSWORD=replace-for-local-development
NEO4J_PASSWORD=replace-for-local-development
POSTGRES_PORT=45432
REDIS_PORT=46379
SIGNALFORGE_INTRADAY_CACHE_TTL=20s
NEO4J_HTTP_PORT=47474
NEO4J_BOLT_PORT=47687
SIGNALFORGE_DEV_USERNAME=developer
SIGNALFORGE_DEV_PASSWORD=generate-with-scripts-init-dev
SIGNALFORGE_BOOTSTRAP_ENABLED=true
SIGNALFORGE_ALLOW_FIXTURES=false
SIGNALFORGE_BACKEND_PORT=58870
SIGNALFORGE_KNOWLEDGE_WORKER_ENABLED=true
# Optional server-only model extraction and connection; never put the key in NEXT_PUBLIC_*.
SIGNALFORGE_DEEPSEEK_API_KEY=
SIGNALFORGE_DEEPSEEK_MODEL=deepseek-flash
# Evidence worker defaults to the knowledge worker switch when omitted.
SIGNALFORGE_EVIDENCE_WORKER_ENABLED=true
SIGNALFORGE_MODEL_DAILY_TOKEN_LIMIT=100000

# Server-only PI knowledge Agent. init-dev generates the shared token.
SIGNALFORGE_AGENT_TOKEN=
SIGNALFORGE_AGENT_URL=http://127.0.0.1:58872
SIGNALFORGE_AGENT_PROVIDER=deepseek
SIGNALFORGE_AGENT_MODEL=deepseek-flash
# Optional local inference server; requires streaming tool calling.
# SIGNALFORGE_AGENT_BASE_URL=http://127.0.0.1:8000/v1
# SIGNALFORGE_AGENT_API_KEY=
